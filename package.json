{
  "name": "log-analyzer",
  "version": "0.6.0",
  "description": "Windows app that pulls logs from multiple servers over SSH/SCP and shows them in a bundled Grafana + Loki - no Docker needed.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "lucca gugescu",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-binaries": "node scripts/fetch-binaries.js",
    "dist": "npm run fetch-binaries && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.logAnalyzer",
    "productName": "Log Analyzer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stack",
        "to": "stack",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
