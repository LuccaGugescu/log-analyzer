{
  "name": "log-analyzer",
  "version": "0.2.0",
  "description": "Windows app that pulls logs from multiple servers over SCP/SSH every 15s and ships them to a local Grafana + Loki stack in Docker.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "lucca gugescu",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.logAnalyzer",
    "productName": "Log Analyzer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stack",
        "to": "stack",
        "filter": [
          "**/*",
          "!sample-logs/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
