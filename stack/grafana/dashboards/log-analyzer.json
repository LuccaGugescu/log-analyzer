{
  "uid": "log-analyzer",
  "title": "Log Analyzer",
  "description": "Logs pulled by the Log Analyzer app. Filter with the bar above, or open a log line and use the + / − magnifiers next to a label.",
  "tags": [
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Logs Drilldown",
      "tooltip": "Point-and-click filtering, field breakdowns and log patterns",
      "type": "link",
      "url": "/a/grafana-lokiexplore-app/explore",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "server",
          "type": 1,
          "stream": "",
          "refId": "server"
        },
        "definition": "label_values(server)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "dir",
        "label": "Directory",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "dir",
          "type": 1,
          "stream": "{server=~\"$server\"}",
          "refId": "dir"
        },
        "definition": "label_values({server=~\"$server\"}, dir)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "file",
        "label": "File",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "file",
          "type": 1,
          "stream": "{server=~\"$server\", dir=~\"$dir\"}",
          "refId": "file"
        },
        "definition": "label_values({server=~\"$server\", dir=~\"$dir\"}, file)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "level",
          "type": 1,
          "stream": "{server=~\"$server\"}",
          "refId": "level"
        },
        "definition": "label_values({server=~\"$server\"}, level)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "include",
        "label": "Contains (regex)",
        "description": "Type a word or regex and press Enter; several values are OR-ed. Case-insensitive.",
        "type": "custom",
        "query": "anything : (?:)",
        "multi": true,
        "includeAll": false,
        "allowCustomValue": true,
        "current": {
          "text": [
            "anything"
          ],
          "value": [
            "(?:)"
          ]
        },
        "options": [
          {
            "text": "anything",
            "value": "(?:)",
            "selected": true
          }
        ]
      },
      {
        "name": "exclude",
        "label": "Excludes (regex)",
        "description": "Type a word or regex and press Enter to hide matching lines; several values are OR-ed.",
        "type": "custom",
        "query": "nothing : [^\\s\\S]",
        "multi": true,
        "includeAll": false,
        "allowCustomValue": true,
        "current": {
          "text": [
            "nothing"
          ],
          "value": [
            "[^\\s\\S]"
          ]
        },
        "options": [
          {
            "text": "nothing",
            "value": "[^\\s\\S]",
            "selected": true
          }
        ]
      },
      {
        "name": "Filters",
        "label": "Label filters",
        "type": "adhoc",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "filters": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lines by level",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}` [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lines by directory",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server, dir) (count_over_time({server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}` [$__auto]))",
          "legendFormat": "{{server}} · {{dir}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lines",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}` [$__auto]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} | level=~\"error|fatal\" |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}` [$__auto]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Busiest files",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, sum by (server, file) (count_over_time({server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}` [$__auto])))",
          "legendFormat": "{{server}} · {{file}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs",
      "description": "Click a line to see its labels; the + / − magnifiers add a filter for or against that value.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{server=~\"$server\", dir=~\"$dir\", file=~\"$file\", level=~\"$level\"} |~ `(?i)${include:pipe}` !~ `(?i)${exclude:pipe}`"
        }
      ]
    }
  ]
}
