{
  "uid": "log-analyzer",
  "title": "Log Analyzer",
  "tags": ["logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "server", "type": 1, "stream": "", "refId": "server" },
        "definition": "label_values(server)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "file",
        "label": "File",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "file", "type": 1, "stream": "{server=~\"$server\"}", "refId": "file" },
        "definition": "label_values({server=~\"$server\"}, file)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines per server",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (count_over_time({server=~\"$server\", file=~\"$file\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per server",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (count_over_time({server=~\"$server\", file=~\"$file\"} |= \"$search\" | detected_level=~\"error|fatal|critical\" [$__auto]))",
          "legendFormat": "{{server}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lines (range)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({server=~\"$server\", file=~\"$file\"} |= \"$search\" [$__auto]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors (range)",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({server=~\"$server\", file=~\"$file\"} |= \"$search\" | detected_level=~\"error|fatal|critical\" [$__auto]))",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Lines by level",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "legend": { "displayMode": "list", "placement": "right" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (count_over_time({server=~\"$server\", file=~\"$file\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{server=~\"$server\", file=~\"$file\"} |= \"$search\""
        }
      ]
    }
  ]
}
