// Every file the Windows app writes lands at /logs/<server>/<file>.log.
local.file_match "pulled" {
  path_targets = [{"__path__" = "/logs/*/*.log"}]
  sync_period  = "5s"
}

loki.source.file "pulled" {
  targets       = local.file_match.pulled.targets
  forward_to    = [loki.process.labels.receiver]
  tail_from_end = false
}

loki.process "labels" {
  // The app marks the first line of every entry with \x1E; unmarked lines
  // (request/response payloads, stack traces) join the entry above them.
  // max_wait_time is longer than the 15s poll so a block split across two
  // polls still ends up whole.
  stage.multiline {
    firstline     = `^\x{1E}`
    max_wait_time = "30s"
    max_lines     = 1000
  }

  stage.replace {
    expression = `(\x{1E})`
    replace    = ""
  }

  // Turn the folder layout into `server` and `file` labels.
  stage.regex {
    source     = "filename"
    expression = "^/logs/(?P<server>[^/]+)/(?P<file>[^/]+)\\.log$"
  }

  // First level word in the line, normalized to trace/debug/info/warn/error/fatal,
  // so it can be filtered and clicked like any other label. Lines without one
  // keep "unknown" (stages below only run when a level was found).
  stage.static_labels {
    values = { level = "unknown" }
  }

  stage.regex {
    expression = `(?i)\b(?P<level>trace|debug|info|notice|warn(?:ing)?|err(?:or)?|crit(?:ical)?|fatal|alert|emerg(?:ency)?|panic)\b`
  }

  stage.template {
    source   = "level"
    template = `{{ $v := ToLower .Value }}{{ if or (eq $v "warning") (eq $v "warn") }}warn{{ else if or (eq $v "err") (eq $v "error") }}error{{ else if or (eq $v "crit") (eq $v "critical") (eq $v "fatal") (eq $v "alert") (eq $v "emerg") (eq $v "emergency") (eq $v "panic") }}fatal{{ else if eq $v "notice" }}info{{ else }}{{ $v }}{{ end }}`
  }

  stage.labels {
    values = {
      server = "",
      file   = "",
      level  = "",
      // Logs Drilldown groups by service_name; one "service" per server.
      service_name = "server",
    }
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
